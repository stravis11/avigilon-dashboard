# Server Configuration
PORT=3001
NODE_ENV=development

# Dashboard JWT secrets
# Required in production (NODE_ENV=production). The process refuses to start
# if these are missing, empty, shorter than 32 characters, or set to a known default.
# openssl rand -hex 32 produces 64 hex characters (32 bytes).
# Development may omit them and will use clearly-dev-only fallbacks.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional: force Secure cookie flag (true/false). Default: auto from HTTPS / X-Forwarded-Proto.
# COOKIE_SECURE=true

# Avigilon ACC Configuration
# Default WEP port is 8443 (or 443 on production appliances)
ACC_SERVER_URL=https://localhost:8443
ACC_USERNAME=your_acc_username
ACC_PASSWORD=your_acc_password
ACC_USER_NONCE=your_user_nonce
ACC_USER_KEY=your_user_key
ACC_CLIENT_NAME=AvigilonWebApp

# Zabbix Configuration (SNMP hardware monitoring)
# Generate an API token in Zabbix: click your username → Profile → API tokens → Add
ZABBIX_URL=https://gtpd-zabbix.police.gatech.edu/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=your_zabbix_api_token

# ArcGIS Camera Map (read-only FeatureLayer)
ARCGIS_FEATURE_LAYER_URL=https://your-arcgis-server/arcgis/rest/services/your-service/FeatureServer/0
ARCGIS_API_KEY=your_arcgis_api_key
ARCGIS_IP_FIELD=ipAddress
# Optional display label field from the FeatureLayer
ARCGIS_LABEL_FIELD=name
# Optional ArcGIS fields for map layer grouping and camera direction arrows
ARCGIS_TYPE_FIELD=Type_of_Camera
ARCGIS_DIRECTION_FIELD=Direction_of_Camera__Degrees_
# Optional if the ArcGIS API key is restricted to specific HTTP referrers
ARCGIS_REFERER=https://your-dashboard-host.example.edu
ARCGIS_CACHE_TTL_MS=3600000

# Avigilon Cloud (optional hardware health)
CLOUD_SITE_ID=your_cloud_site_id
CLOUD_TOKEN_SECRET=pick-a-secret-passphrase
CLOUD_EMAIL=your_cloud_portal_email
CLOUD_PASSWORD=your_cloud_portal_password

# Recording Availability (read-only observed retention estimate)
RECORDING_AVAILABILITY_INTERVAL_MS=86400000
RECORDING_AVAILABILITY_SAMPLE_SIZE=3
RECORDING_AVAILABILITY_LOOKBACK_DAYS=365
RECORDING_AVAILABILITY_HISTORY_LIMIT=5000
# Optional override for runtime history storage
# RECORDING_AVAILABILITY_DATA_FILE=/var/lib/avigilon-dashboard/recordingAvailability.json

# CORS Configuration
# Include the browser origin. Docker SPA is same-origin via nginx /api proxy.
# Local Vite defaults to http://localhost:3000 (see frontend/vite.config.js).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
